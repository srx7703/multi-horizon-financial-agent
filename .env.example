# Copy to .env and fill in. .env is gitignored.

# --- Claude (Anthropic) ---
# Two routes: direct API or via Vertex AI (preferred — eats GCP credit).
# Set ANTHROPIC_BACKEND=vertex to use Vertex; "direct" uses ANTHROPIC_API_KEY.
ANTHROPIC_BACKEND=vertex

# Direct-API route (only used if ANTHROPIC_BACKEND=direct):
ANTHROPIC_API_KEY=

# Vertex-AI route (only used if ANTHROPIC_BACKEND=vertex):
GCP_PROJECT_ID=
VERTEX_REGION=us-east5

# --- Tavily web search ---
# Free tier: 1000 queries/month. Sign up at https://tavily.com
TAVILY_API_KEY=

# --- SEC EDGAR ---
# SEC requires a contact-info User-Agent on every request. Use real info.
SEC_USER_AGENT="Your Name your.email@example.com"

# --- Optional: local SEC summaries (sister-repo dump) ---
# When set, tools/sec.py reads pre-distilled JSON from this dir instead of
# refetching+parsing from SEC EDGAR. Big speedup for development.
# Point this at multi-horizon-financial-llm/summaries_10q (or 10k, 8k).
MHFA_LOCAL_SEC_DIR=

# --- Search provider ---
# "tavily" (default) or "mock" (for offline testing).
MHFA_SEARCH_PROVIDER=tavily
