# Copy to .env and fill in. .env is gitignored.

# --- LLM provider routing ---
# Per-role provider/model assignments live in configs/models.yaml. v0.1
# ships with Gemini 2.5 (Pro for synthesizer, Flash for planner / tool_synth /
# judge) on Vertex AI. See decision D-009 for why Anthropic is deferred to
# the Phase 2 A/B harness (synthesizer_b slot).

# --- GCP / Vertex AI (used for both Gemini and Anthropic) ---
GCP_PROJECT_ID=
# us-central1 has Gemini 2.5; us-east5 has Anthropic on Vertex. The Gemini
# adapter auto-falls-back from us-east5 → us-central1 if you pinned us-east5
# for Anthropic.
VERTEX_REGION=us-central1

# --- Anthropic (only consumed when a role's provider is "anthropic") ---
# v0.1 only synthesizer_b uses provider=anthropic, and synthesizer_b is a
# Phase 2 slot — leave these blank for the MVP.
# Two routes: vertex (preferred — same GCP billing) or direct (uses key).
ANTHROPIC_BACKEND=vertex
ANTHROPIC_API_KEY=

# --- Tavily web search ---
# Free tier: 1000 queries/month. Sign up at https://tavily.com
TAVILY_API_KEY=

# --- SEC EDGAR ---
# SEC requires a contact-info User-Agent on every request. Use real info.
SEC_USER_AGENT="Your Name your.email@example.com"

# --- Optional: local SEC summaries (sister-repo dump) ---
# When set, tools/sec.py reads pre-distilled JSON from this dir instead of
# refetching+parsing from SEC EDGAR. Big speedup for development.
# Point this at multi-horizon-financial-llm/summaries_10q (or 10k, 8k).
MHFA_LOCAL_SEC_DIR=

# --- Search provider ---
# "tavily" (default) or "mock" (for offline testing).
MHFA_SEARCH_PROVIDER=tavily
